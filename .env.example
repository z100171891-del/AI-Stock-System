# ============================================
# AI 股票分析系統 - 環境變數設定範本
# 複製此檔案為 .env，並填入你自己的金鑰/帳密
# .env 內含機密資訊，切勿提交到 GitHub（已列在 .gitignore）
# ============================================

# ---- 追蹤股票（以逗號分隔股票代號，台股不用加 .TW，程式會自動補上）----
STOCK_LIST=2330,2317,0050

# ---- FinMind API Token（選填，用於籌碼面資料：三大法人/融資融券/大股東持股）----
# 免費註冊：https://finmindtrade.com/
FINMIND_TOKEN=

# ---- AI 多模型分析引擎（至少擇一填入，全部留空則系統改用規則式摘要，不影響其他功能）----
# Gemini：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini 分析預設會開啟 Google Search grounding，讓「核心發動題材」段落能查到
# 近期真實消息（而不是憑訓練資料亂猜）。免費方案的搜尋額度有限，超過額度該次
# 呼叫會自動退回規則式摘要；若想關掉搜尋（改用純語言模型回答），設 false。
GEMINI_ENABLE_GROUNDING=true

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq：https://console.groq.com/keys
GROQ_API_KEY=

# ---- Email 通知（Gmail）----
# 寄件者 Gmail 帳號
EMAIL_SENDER=
# Gmail「應用程式密碼」，非一般登入密碼
# 申請教學：Google帳戶 -> 安全性 -> 兩步驟驗證 -> 應用程式密碼
EMAIL_APP_PASSWORD=
# 收件者信箱（可多個，用逗號分隔）
EMAIL_RECEIVER=

# ---- 其他 ----
# 時區（用於報告時間戳記）
TIMEZONE=Asia/Taipei
